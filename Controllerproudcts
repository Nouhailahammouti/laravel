public function edit(creat_table  $prouducts){
     return view('edit',['prouducts'=> $prouducts]);
}
public function update(creat_table  $prouducts,Request $request){
        $data = $request->validate([
            'name'  => 'required',
            'qty'   => 'required|numeric', 
            'price' => 'required|numeric', 
            'des'   => 'required',
        ]);
    $prouducts->update($data);
    return  redirect(route('proudct.index'))->with('Done!');
   
}
public function delet(creat_table  $prouducts){
       $prouducts->delete();
       return  redirect(route('proudct.index'))->with('Done!');

}
public function Archife(creat_table $prouducts) {
    $prouducts->update(['is_archived' => true]);
    return redirect(route('proudct.index'))->with('success', 'Moved to Archive!');
}

public function showArchive() {
    $archived = creat_table::where('is_archived', true)->get();
    return view('Archife', ['proudacts' => $archived]);
}
public function archiveIndex() {
    $archived = creat_table::where('is_archived', true)->get();
    
    return view('Archife', ['proudacts' => $archived]);
} 
